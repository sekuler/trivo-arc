# Arc Basket — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Network mode
# Default is Arc Mainnet (chain ID 5042).
# Set to "false" to switch to Arc Testnet (chain ID 5042002).
VITE_MAINNET=true

# Optional: custom Arc RPC (leave blank to use public endpoints)
# VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# VITE_ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
